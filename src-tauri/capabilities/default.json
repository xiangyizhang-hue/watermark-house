{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FrameLab 主窗口能力：核心事件与对话框权限。所有文件 IO 均通过自定义 Rust Command（invoke）完成，WebView 不直接访问文件系统。",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-destroy", "core:window:allow-is-fullscreen", "core:window:allow-set-fullscreen", "dialog:default", "updater:default"]
}
